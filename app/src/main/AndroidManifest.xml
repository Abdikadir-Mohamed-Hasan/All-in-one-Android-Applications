<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.consumerir"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AllinoneController"
        android:usesCleartextTraffic="true">

        <!-- Main Launcher Screen: Teacher Assignment Hub -->
        <activity
            android:name=".features.hub.AssignmentHubActivity"
            android:exported="true"
            android:label="@string/title_assignment_hub"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Assignment 1: Phone Controller Screen -->
        <activity
            android:name=".features.phonecontroller.PhoneControllerActivity"
            android:exported="false"
            android:label="@string/title_dashboard"
            android:parentActivityName=".features.hub.AssignmentHubActivity" />

        <!-- Assignment 2: Quran App Screens -->
        <activity
            android:name=".features.quran.ui.QuranHomeActivity"
            android:exported="false"
            android:label="@string/quran_app_title"
            android:parentActivityName=".features.hub.AssignmentHubActivity" />

        <activity
            android:name=".features.quran.ui.SheikhSelectionActivity"
            android:exported="false"
            android:label="Select Sheikh"
            android:parentActivityName=".features.quran.ui.QuranHomeActivity" />

        <activity
            android:name=".features.quran.ui.SurahLibraryActivity"
            android:exported="false"
            android:label="Surah Library"
            android:parentActivityName=".features.quran.ui.SheikhSelectionActivity" />

        <activity
            android:name=".features.quran.ui.DarsSelectionActivity"
            android:exported="false"
            android:label="Dars List"
            android:parentActivityName=".features.quran.ui.SurahLibraryActivity" />

        <activity
            android:name=".features.quran.ui.QuranPlayerActivity"
            android:exported="false"
            android:label="Quran Audio Player"
            android:parentActivityName=".features.quran.ui.SurahLibraryActivity" />

        <!-- Assignment 3: Baro Dalkaga Screens -->
        <activity
            android:name=".features.barodalkaga.BaroDalkagaActivity"
            android:exported="false"
            android:label="@string/baro_dalkaga_title"
            android:parentActivityName=".features.hub.AssignmentHubActivity" />

        <activity
            android:name=".features.barodalkaga.RegionsListActivity"
            android:exported="false"
            android:label="Regions of Somalia"
            android:parentActivityName=".features.barodalkaga.BaroDalkagaActivity" />

        <activity
            android:name=".features.barodalkaga.RegionDetailActivity"
            android:exported="false"
            android:label="Region Details"
            android:parentActivityName=".features.barodalkaga.RegionsListActivity" />

        <!-- Assignment 4: Projector Controller Screen -->
        <activity
            android:name=".features.projectorcontroller.ProjectorControllerActivity"
            android:exported="false"
            android:label="@string/title_projector_controller"
            android:parentActivityName=".features.hub.AssignmentHubActivity" />

        <!-- Assignment 5: Somalia Tour Guide -->
        <activity
            android:name=".features.tourguide.TourGuideHomeActivity"
            android:exported="false"
            android:label="Somalia Tour Guide"
            android:parentActivityName=".features.hub.AssignmentHubActivity" />

        <activity
            android:name=".features.tourguide.AttractionsListActivity"
            android:exported="false"
            android:label="Tourist Attractions"
            android:parentActivityName=".features.tourguide.TourGuideHomeActivity" />

        <activity
            android:name=".features.tourguide.AttractionDetailActivity"
            android:exported="false"
            android:label="Attraction Details"
            android:parentActivityName=".features.tourguide.AttractionsListActivity" />

    </application>

</manifest>