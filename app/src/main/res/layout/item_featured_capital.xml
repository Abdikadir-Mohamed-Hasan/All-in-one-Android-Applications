<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="190dp"
    android:layout_marginEnd="14dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/card_click_animator"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Capital Hero Image -->
        <ImageView
            android:id="@+id/ivFeaturedImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="Capital City"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_region_hero_default" />

        <!-- Scrim Gradient overlay on image -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignBottom="@id/ivFeaturedImage"
            android:background="@drawable/scrim_gradient_bottom" />

        <!-- Zone Badge top-left -->
        <TextView
            android:id="@+id/tvFeaturedZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_status_pill_ready"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Northern"
            android:textColor="@color/color_active_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Capital City Name on image bottom -->
        <TextView
            android:id="@+id/tvFeaturedCapital"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/ivFeaturedImage"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="8dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Mogadishu"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Region & Details Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ivFeaturedImage"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvFeaturedRegion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Banaadir Region"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFeaturedYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Est. 1960 • View Details"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>

