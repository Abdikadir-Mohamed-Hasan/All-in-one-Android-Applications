<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/card_click_animator"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Capital Hero Thumbnail Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="66dp"
            android:layout_height="66dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivRegionThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Capital City"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_region_hero_default" />

            <TextView
                android:id="@+id/tvRegionIndex"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_status_pill_ready"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/color_active_green"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Region Name & Attributes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRegionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Awdal"
                android:textColor="@color/text_primary"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRegionCapital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/ic_location_pin"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_secondary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Capital: Borama"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Pill Badges: Zone & Year -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRegionZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tag_pill"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="Northern"
                    android:textColor="#059669"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRegionYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill_ready"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/color_active_green"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="1984"
                    android:textColor="@color/color_active_green"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chevron Action Pill -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_status_pill_ready"
            android:contentDescription="Open Details"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/color_active_green" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
