<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attractionDetailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Header Section (260dp) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/ivAttractionHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Attraction Hero"
                    android:scaleType="centerCrop"
                    android:src="@drawable/liido_beach" />

                <!-- Bottom Scrim Gradient for text contrast -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_gradient_bottom" />

                <!-- Floating Top Action Bar: Back & Share -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        app:cardBackgroundColor="#80000000"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageButton
                            android:id="@+id/btnBackDetail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/back"
                            android:padding="10dp"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        app:cardBackgroundColor="#80000000"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageButton
                            android:id="@+id/btnShareAttraction"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Share"
                            android:padding="10dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>

                <!-- Hero Bottom Overlay (Badge, Title, Location) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvDetailCategoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Beautiful Beaches"
                        android:textColor="#059669"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailAttractionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:text="Liido Beach"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailLocationBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawableStart="@drawable/ic_location_pin"
                        android:drawablePadding="5dp"
                        android:drawableTint="#D1FAE5"
                        android:gravity="center_vertical"
                        android:shadowColor="#B3000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="Mogadishu, Banaadir, Somalia"
                        android:textColor="#D1FAE5"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 2-Stat Row: Location & GPS Coordinates -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Stat 1: Category -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_capitol_building"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/color_active_green"
                                android:gravity="center_vertical"
                                android:text="Attraction Type"
                                android:textColor="@color/color_active_green"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Coastal Beach"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Stat 2: Coordinates -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_location_pin"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/color_active_blue"
                                android:gravity="center_vertical"
                                android:text="GPS Coordinates"
                                android:textColor="@color/color_active_blue"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailCoordinates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="2.0371° N, 45.3638° E"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Detailed Description & History Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_book_open"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/color_active_green"
                            android:gravity="center_vertical"
                            android:text="About &amp; Historical Significance"
                            android:textColor="@color/color_active_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailFullDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="5dp"
                            android:text="Detailed description of the attraction goes here..."
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Open in Google Maps Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGoogleMaps"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#0284C7"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="Open in Google Maps"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_location_pin"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

