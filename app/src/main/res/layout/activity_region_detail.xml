<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/regionDetailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    tools:context=".features.barodalkaga.RegionDetailActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Header with Scrim and Floating Navigation -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <!-- Capital City Hero Image -->
                <ImageView
                    android:id="@+id/ivRegionHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Capital City Hero"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_region_hero_default" />

                <!-- Gradient Scrim overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/scrim_gradient_bottom" />

                <!-- Top Floating Action Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_status_pill_ready"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/color_active_green" />

                    <ImageButton
                        android:id="@+id/btnShare"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_pill_ready"
                        android:contentDescription="Share"
                        android:src="@drawable/ic_share"
                        app:tint="@color/color_active_green" />
                </RelativeLayout>

                <!-- Floating Bottom Title & Badges on Hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDetailZoneBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_pill_ready"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="Northern Zone"
                            android:textColor="@color/color_active_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailHeroYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tag_pill"
                            android:drawableStart="@drawable/ic_calendar"
                            android:drawablePadding="4dp"
                            android:drawableTint="#059669"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="Est. 1984"
                            android:textColor="#059669"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailRegionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:text="Awdal"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailCapitalBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawableStart="@drawable/ic_location_pin"
                        android:drawablePadding="4dp"
                        android:drawableTint="#D1FAE5"
                        android:gravity="center_vertical"
                        android:shadowColor="#B3000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="Capital: Borama"
                        android:textColor="#D1FAE5"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Content Body Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <!-- 2x2 Interactive Quick Stats Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <!-- Stat 1: Capital -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_capitol_building"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/color_active_green"
                                android:gravity="center_vertical"
                                android:text="Capital City"
                                android:textColor="@color/color_active_green"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailCapital"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Borama"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Stat 2: Established -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_calendar"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/color_active_green"
                                android:gravity="center_vertical"
                                android:text="Established"
                                android:textColor="@color/color_active_green"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailEstablished"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="1984"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Famous For Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_star"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/color_active_green"
                                android:gravity="center_vertical"
                                android:text="Famous Attributes"
                                android:textColor="@color/color_active_green"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_pill"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Key Highlights"
                                android:textColor="#059669"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailFamousFor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="4dp"
                            android:text="Amoud University, agriculture, and the historic ancient port of Zeila"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- History & Description Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_book_open"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/color_active_green"
                            android:gravity="center_vertical"
                            android:text="History &amp; Geography"
                            android:textColor="@color/color_active_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="5dp"
                            android:text="Detailed description of the region goes here..."
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Button: Share Region Information -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareBottom"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="#059669"
                    android:elevation="3dp"
                    android:stateListAnimator="@animator/card_click_animator"
                    android:text="Share Region Facts"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
